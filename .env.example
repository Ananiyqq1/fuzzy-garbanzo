# Copy this file to `.env.local` and adjust values as needed
# Base URL for API requests (leave empty to use Vite proxy in development)
# In production, set this to your actual backend URL
VITE_API_BASE_URL=http://localhost:8090

# Base URL for SignalR hubs (optional — defaults to API base with `/roomHub`)
VITE_SIGNALR_URL=http://localhost:5138/roomHub
